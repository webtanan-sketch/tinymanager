{
  "name": "tinymanager",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A modular, local-first bilingual manager workspace with first-class Persian RTL support.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "lucide-react": ">=0.400.0 <1",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "react-router-dom": ">=7 <8",
    "tiny-decision-matrix": "github:webtanan-sketch/tiny-decision-matrix#6ee38930ab38ac83312967de1418a3f9dc6d9e98",
    "webtanan-jalali-date-engine": "github:webtanan-sketch/webtanan-jalali-date-engine#5fc682ca3c7ed97923b152650516feaaa40b6a50"
  },
  "devDependencies": {
    "@tailwindcss/vite": ">=4 <5",
    "@types/react": ">=19 <20",
    "@types/react-dom": ">=19 <20",
    "@vitejs/plugin-react": ">=5 <7",
    "tailwindcss": ">=4 <5",
    "typescript": ">=5.8 <7",
    "vite": ">=7 <9",
    "vitest": ">=3 <5"
  }
}
